    - target: {fileID: 1306340657537249306, guid: 905c1c5a61a62c04ea9c5baa9f3ec596, type: 3}
      propertyPath: m_text
      value: "<color=#9E5C24>Object</color>. A grim, black-feathered shaft, passed down for the day a dragon must finally be answered.\n\n\u2022 <sprite name=\"bow\">Bows - equip at a destination that trades in them\n\u2022 <link=\"ability:Ranged\"><u>Ranged</u> <sprite name=\"longrange\"></link> 100%\n\u2022 <link=\"ability:BonusVersusDragons\"><u>Bonus vs Dragons</u> <sprite name=\"target\"></link> 100%\n\n<align=\"center\"><color=#d3d3d388><i>\"Save the last arrow for the worm's own heart.\"</i></color></align>"
      objectReference: {fileID: 0}
