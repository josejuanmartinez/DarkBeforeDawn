    - target: {fileID: 1306340657537249306, guid: 905c1c5a61a62c04ea9c5baa9f3ec596, type: 3}
      propertyPath: m_text
      value: '<color=#598CCC>PC</color>. North Kingdom (Neutral)

        Dwellers: <link="card:Men of Crossway"><u>Men of Crossway</u></link>.

        Allows recruiting characters born here.

        Playable objects: <sprite name="herb">Remedies, <sprite name="crown">Regalia, <sprite name="key">Tools


        <align="center"><color=#d3d3d388><i>"Crossway keeps faith with the road, though the years grow wary."</i></color></align>'
      objectReference: {fileID: 0}
    - target: {fileID: 1306340657537249306, guid: 905c1c5a61a62c04ea9c5baa9f3ec596, type: 3}
      propertyPath: m_fontSize
      value: 11.7
      objectReference: {fileID: 0}
