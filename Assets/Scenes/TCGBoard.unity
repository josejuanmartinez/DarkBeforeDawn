    - target: {fileID: 1306340657537249306, guid: 905c1c5a61a62c04ea9c5baa9f3ec596, type: 3}
      propertyPath: m_text
      value: "<color=#9E5C24>Object</color>. A tall standard carried at the front of the line, meant to be seen by friend and foe alike.\n\n\u2022 <sprite name=\"banner\">Banners - equip at a destination that trades in them\n\u2022 <link=\"ability:Encouraging\"><u>Encouraging</u> <sprite name=\"encouraging\"></link> 100%\n\n<align=\"center\"><color=#d3d3d388><i>\"Raised high, it turns a retreat into a rally.\"</i></color></align>"
      objectReference: {fileID: 0}
