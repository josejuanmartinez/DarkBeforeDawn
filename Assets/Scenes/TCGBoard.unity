      propertyPath: m_text
      value: "<color=#9E5C24>Object</color>. A tall standard carried at the front of the line, meant to be seen by friend and foe alike.\n\n\u2022 <link=\"ability:Encouraging\"><u>Encouraging</u> <sprite name=\"encouraging\"></link> 100%\n\n<align=\"center\"><color=#d3d3d388><i>\"Raised high, it turns a retreat into a rally.\"</i></color></align>"
